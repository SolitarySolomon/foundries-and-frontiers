<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FoundriesFrontiers</AssemblyName>
    <RootNamespace>FoundriesFrontiers</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <!-- Game assemblies. Never copied to output - the game already has them. -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>refs/VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VintagestoryLib"><HintPath>refs/VintagestoryLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>refs/VSSurvivalMod.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSEssentials"><HintPath>refs/VSEssentials.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSCreativeMod"><HintPath>refs/VSCreativeMod.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>refs/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="protobuf-net"><HintPath>refs/protobuf-net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>refs/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="cairo-sharp"><HintPath>refs/cairo-sharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SkiaSharp"><HintPath>refs/SkiaSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
