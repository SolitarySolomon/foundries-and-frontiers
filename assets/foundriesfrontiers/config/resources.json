{
  "food": {
    "match": ["grain-", "vegetable-", "fruit-", "legume-", "bread-", "dough-", "flour-",
              "redmeat", "bushmeat", "poultry", "fishfillet", "fishraw", "fishchunk",
              "cheese", "butter", "egg-", "honeycomb", "pemmican", "pickled",
              "bambooshoot", "insect-", "cassava", "mushroom"],
    "exclude": ["seeds", "rot", "fishbait", "spice-"],
    "defaultWeight": 1,
    "weights": {
      "redmeat": 2,
      "bushmeat": 2,
      "poultry": 2,
      "cheese": 3,
      "bread-": 2,
      "pemmican": 3,
      "flour-": 1.5,
      "dough-": 1.5,
      "fruit-": 0.5,
      "insect-": 0.25
    }
  },

  "wood": {
    "match": ["log-", "plank-", "firewood", "board-", "lumber", "stick"],
    "exclude": ["logging"],
    "defaultWeight": 1,
    "weights": {
      "log-": 4,
      "plank-": 1,
      "firewood": 1,
      "stick": 0.25
    }
  },

  "stone": {
    "match": ["stone-", "stonebrick", "rock-", "cobble", "gravel", "looserubble", "looseboulders"],
    "exclude": ["grindstone", "whetstone", "millstone", "quern", "stone-coral"],
    "defaultWeight": 1,
    "weights": {
      "stone-": 1,
      "stonebrick": 1.5,
      "rock-": 1,
      "cobble": 1,
      "gravel": 0.5
    }
  },

  "clay": {
    "match": ["clay-", "ceramic", "burnedbrick", "refractorybrick", "shingle", "tile-clay", "daub"],
    "exclude": ["clayworkitem", "clayform"],
    "defaultWeight": 1,
    "weights": {
      "clay-": 1,
      "burnedbrick": 1.5,
      "refractorybrick": 2,
      "shingle": 0.5,
      "tile-clay": 0.5,
      "daub": 0.5
    }
  },

  "metal": {
    "match": ["ingot-", "nugget-", "ore-", "metalbit", "ironbloom", "metalplate", "solderbar", "crystalizedore"],
    "exclude": [],
    "defaultWeight": 1,
    "weights": {
      "ingot-": 4,
      "ironbloom": 3,
      "metalplate": 2,
      "nugget-": 1,
      "ore-": 1,
      "metalbit": 0.25
    }
  },

  "cloth": {
    "match": ["cloth-", "linen", "flaxfibers", "flaxtwine", "wool", "hide-", "leather", "rope"],
    "exclude": [],
    "defaultWeight": 1,
    "weights": {
      "cloth-": 2,
      "linen": 2,
      "leather": 3,
      "hide-": 2,
      "wool": 1,
      "rope": 1,
      "flaxfibers": 0.5,
      "flaxtwine": 0.5
    }
  }
}
