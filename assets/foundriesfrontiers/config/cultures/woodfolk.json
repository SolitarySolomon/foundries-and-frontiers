  "lines": {
    "greet": [
      "Well met, walker.",
      "Mind the roots.",
      "You've come a long way.",
      "Quiet on you.",
      "Morning."
    ],
    "remark": [
      "It'll grow back, given time.",
      "We don't take what we can't give back.",
      "The grove's thick this year.",
      "Slow is fine. Slow is how it lasts.",
      "That stand wants thinning.",
      "Nothing's in a hurry here."
    ],
    "laugh": [
      "Ha! Now that's a tale.",
      "You'd say that, wouldn't you.",
      "Oh, that's good."
    ],
    "shrug": [
      "The grove knows. I don't.",
      "Ask an older head than mine.",
      "Couldn't tell you."
    ],
    "complain": [
      "The stores are thin.",
      "Nobody's walked through in weeks.",
      "We're stretched, and that's the truth of it."
    ],
    "rain": [
      "Good. The roots want it.",
      "Rain's a kindness.",
      "Let it come."
    ],
    "snow": [
      "The grove sleeps.",
      "Cold, but it passes.",
      "Snow means rest."
    ],
    "hot": [
      "No air under the leaves today.",
      "Even the birds have gone quiet.",
      "Too warm for working."
    ],
    "night": [
      "The wood's awake at this hour.",
      "Quiet now.",
      "Best be in before full dark."
    ],
    "dawn": [
      "Light's through the canopy.",
      "Early. Good.",
      "The day's opening."
    ],
    "storm": [
      "The trees don't like this.",
      "Under cover. Now.",
      "Something's coming."
    ],
    "hurt": [
      "Ah! Enough!",
      "Leave off!",
      "Help, someone!"
    ],
    "tired": [
      "I'm worn through.",
      "Long day under the leaves.",
      "My hands are done."
    ],
    "hungry": [
      "Stores are low.",
      "We'll be thin before the thaw.",
      "Not much left."
    ],
    "remark-gruff": [
      "Hm.",
      "Someone's been careless.",
      "That wasn't done right."
    ],
    "remark-whiny": [
      "Why is it always me?",
      "Nobody asks how I am.",
      "My feet ache."
    ],
    "remark-sunny": [
