{
  // Fallbacks for pricing a building block. Read the top of BlockPricer.cs first: the
  // order matters and this file is the last two rungs of it, not the first.
  //
  //   1. The storehouse resource table, if a village would accept the thing as a deposit.
  //   2. The game's own crafting recipe, added up from what it consumes.
  //   3. byCode below, for the handful of things with no useful recipe.
  //   4. byMaterial below, as a floor.
  //
  // Everything a building is normally made of should be priced by 1 or 2. If /ff buildings
  // reports a lot coming from material or from this file, something worth pricing properly
  // is falling through, and the fix is usually a missing fragment in resources.json rather
  // than another line here.

  "byCode": {
    // Placed as a block by hand rather than crafted, so no grid recipe exists. The
    // number is what the game's own recipe for the loose material costs.
    "thatch":   { "pool": "earth", "value": 1 },

    // Worked at a station rather than crafted in a grid: knapping, clay forming, or
    // building in place. Priced at roughly what the station consumes.
    "anvil":    { "pool": "metal", "value": 20 },
    "bloomery": { "pool": "clay",  "value": 12 },
    "forge":    { "pool": "stone", "value": 10 },
    "quern":    { "pool": "stone", "value": 8 },
    "clayoven": { "pool": "clay",  "value": 10 },
    "pitkiln":  { "pool": "wood",  "value": 4 },
    "firepit":  { "pool": "wood",  "value": 2 },

    // "cob" is a substring of cobblestone and cobbleskull, and longest fragment wins,
    // so this entry is what keeps a stone block from being priced as earth.
    "cobble":   { "pool": "stone", "value": 1 }
  },

  // The floor. A block with no deposit price and no recipe is worth what it is made of.
  "byMaterial": {
    "Soil":    { "pool": "earth", "value": 1 },
    "Gravel":  { "pool": "stone", "value": 0.5 },
    "Sand":    { "pool": "earth", "value": 0.5 },
    "Wood":    { "pool": "wood",  "value": 1 },
    "Leaves":  { "pool": "earth", "value": 0.5 },
    "Plant":   { "pool": "earth", "value": 0.5 },
    "Stone":   { "pool": "stone", "value": 1 },
    "Ore":     { "pool": "stone", "value": 1 },
    "Metal":   { "pool": "metal", "value": 3 },
    "Glass":   { "pool": "clay",  "value": 3 },
    "Ceramic": { "pool": "clay",  "value": 1 },
    "Brick":   { "pool": "clay",  "value": 1.5 },
    "Cloth":   { "pool": "cloth", "value": 2 },
    "Snow":    { "pool": "earth", "value": 0 },
    "Ice":     { "pool": "earth", "value": 0 },
    "Water":   { "pool": "earth", "value": 0 },
    "Lava":    { "pool": "stone", "value": 0 },
    "Other":   { "pool": "stone", "value": 0.5 }
  }
}
