	client: {
		renderer: "Shape",
		pitchStep: false,

		// The player's own model. seraph-faceless is correct here rather than plain
		// seraph: the face is supplied as a skin part, and using the shape that bakes
		// one in leaves a detached head floating at the model origin.
		shape: { base: "game:entity/humanoid/seraph-faceless" },
		texture: { base: "game:entity/humanoid/seraph-naked-hairless" },

		behaviors: [
			{ code: "nametag", showtagonlywhentargeted: false },
			{ code: "repulseagents" },
			{ code: "controlledphysics", stepHeight: 1.05 },
			{ code: "interpolateposition" },
			{ code: "seraphinventory" },
			{ code: "extraskinnable" }
		],
		animations: [
			{ code: "idle",   animation: "idle1",   blendMode: "Average", triggeredBy: { defaultAnim: true } },
			// Deliberately NOT mulWithWalkSpeed. That flag ties animation rate to movement
			// speed, so any mismatch between the two shows up as sliding feet. The base
			// game's own villagers avoid it for exactly this reason - a fixed rate always
			// reads as walking even when the speed changes.
			{ code: "walk",   animation: "walk",    blendMode: "Average", animationSpeed: 1.0 },
			{ code: "run",    animation: "sprint",  blendMode: "Average", animationSpeed: 1.0 },
			{ code: "hurt",   animation: "hit",     blendMode: "AddAverage", animationSpeed: 2 },
			{ code: "die",    animation: "die",     blendMode: "AddAverage", animationSpeed: 1.5, weight: 10 },
			{ code: "sleep",  animation: "lie",     blendMode: "Add" },
			{ code: "sit",    animation: "sitidle", blendMode: "Average" },

			// Work animations, waiting for the AI tasks that will drive them.
			{ code: "hammer", animation: "hammerhit", blendMode: "AddAverage" },
			{ code: "mine",   animation: "pickaxe",   blendMode: "AddAverage" },
			{ code: "smith",  animation: "smithing",  blendMode: "AddAverage" }
		]
	},
	server: {
		attributes: {
			pathfinder: {
				minTurnAnglePerSec: 720,
				maxTurnAnglePerSec: 1440
			}
		},
		behaviors: [
			{ code: "nametag", showtagonlywhentargeted: false },
			{ code: "repulseagents" },
			{ code: "controlledphysics", stepHeight: 1.05 },
			{ code: "health", currenthealth: 20, maxhealth: 20 },
			{ code: "breathe" },
			{ code: "seraphinventory" },
			{ code: "extraskinnable" },
			{ code: "ffchatter" },
			{
				code: "taskai",
				aiCreatureType: "Humanoid",
				aitasks: [
					{
						code: "wander",
						priority: 1.0,
						movespeed: 0.030,

						// Tether. Villagers belong somewhere and should not drift off across
						// the map between jobs. Anchored to their spawn point for now; once
						// villages exist this becomes the claim centre, and leaving it will
						// require an actual reason - a job, a caravan, a raid.
						maxDistanceToSpawn: 24,
						wanderRangeMin: 3,
						wanderRangeMax: 12,

						preferredLightLevel: 12,
						maxHeight: 5,
						minTurnAnglePerSec: 120,
						maxTurnAnglePerSec: 360,
						mincooldown: 8000,
						maxcooldown: 25000,
						animation: "walk",
						animationSpeed: 1.0
					},
					{
						code: "lookaround",
						priority: 0.5,
						mincooldown: 4000,
						maxcooldown: 12000
					},
					{
						// Highest of the ambient tasks: an order to be somewhere beats
						// pottering about. Real work will sit above this again.
						// Slot 1, on its own. Walking is a service the deciding tasks in
						// slot 0 ask for, so it has to be able to run alongside them
						// rather than shouldering whichever one gave it the order.
						code: "ffgoto",
						slot: 1,
						priority: 2.0,
						priorityForCancel: 2.0
					},
					{
						// Bedtime outranks the tether: a villager caught outside at dusk
						// should be heading for their own bed, not for the village centre.
						code: "ffsleep",
						priority: 1.8,
						priorityForCancel: 1.8
					},
					{
						// The tether. Above wandering, below an explicit order, because
						// being told to go somewhere is itself a reason to leave.
						code: "ffhome",
						priority: 1.6,
						priorityForCancel: 1.6
					},
					{
						code: "ffloiter",
						priority: 0.8,
						chance: 0.15
					}
				]
			}
		]
	},
	sounds: {
		hurt: "game:player/hurt",
		death: "game:player/death"
	},
	idleSoundChance: 0
}
